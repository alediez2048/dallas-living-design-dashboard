# Environment schema for the Admin AI Editor. Copy to .env.local and fill with real values.
# .env.local is gitignored. In production, set these via `railway variables`. Never commit real secrets.

# --- Clerk (auth) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx   # client-safe (shipped in bundle; used by @clerk/clerk-react)
CLERK_PUBLISHABLE_KEY=pk_test_xxx        # same value, non-VITE name for @clerk/express
CLERK_SECRET_KEY=sk_test_xxx             # SERVER ONLY — never expose to client

# --- Admin gating (server-only) ---
ADMIN_ALLOWLIST=admin@example.com        # comma-separated allow-listed admin emails
ADMIN_CODE=XXXX-XXXX                     # secret admin code (constant-time compared server-side)
ADMIN_SESSION_SECRET=                    # random 32-byte hex; signs the admin session token

# --- Database (Railway injects this automatically in production) ---
DATABASE_URL=                            # postgres connection string

# --- LLM provider (BYO key, added via admin Settings) ---
OPENAI_API_KEY=                          # optional
ANTHROPIC_API_KEY=                       # optional

# --- GitHub automation (Phase 3 agent) ---
GITHUB_TOKEN=                            # fine-grained PAT / GitHub App token, this repo only
GITHUB_REPO=owner/repo
